# AfriVogue server settings. On Hostinger, add these in hPanel → your Node.js app →
# Environment variables. Locally, copy this file to .env.

# ── Required ──
APP_URL=https://afrivogue.com
NODE_ENV=production

# MySQL database (hPanel → Databases → MySQL Databases). Either the full URL...
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# ...or the separate values:
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Your email. This account becomes the admin once you confirm the email address.
# Several admins: separate with commas.
ADMIN_EMAIL=

# Long random strings (use a password generator). Keep them secret.
APP_SECRET=
CRON_SECRET=

# ── Email (your Hostinger mailbox, the same setup as foundright.ng) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@afrivogue.com
SMTP_PASSWORD=
EMAIL_FROM=AfriVogue <hello@afrivogue.com>
# Where contact-form messages and new-order alerts go (defaults to SMTP_USER)
CONTACT_INBOX=

# ── Claude content engine and Style Concierge ──
ANTHROPIC_API_KEY=
# Finds fresh sources for stories, forecasts and the moodboard
FIRECRAWL_API_KEY=

# ── Stripe (Insider membership and the shop) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: your own price IDs (defaults are the current Insider prices)
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# Optional: countries the shop ships to, comma-separated ISO codes
# SHIP_COUNTRIES=NG,GH,KE,ZA,US,GB,CA

# ── Optional tuning ──
# Style Concierge looks per day for guests / free Collective / Insiders
# CONCIERGE_DAILY_GUEST=1
# CONCIERGE_DAILY_FREE=5
# CONCIERGE_DAILY_MEMBER=40
# Where uploaded images are kept (relative to the app folder)
# UPLOAD_DIR=uploads
